#!name=自动任务脚本
#!desc=自动签到、Cookie 更新、定时任务
#!category=系统

[Script]
# 自动测速
auto-speed = type=cron,cronexp="0 */10 * * * *",script-path=https://raw.githubusercontent.com/kongjie0325-art/shadowrocket-anywhere-config/master/scripts/auto-speed.js

# 自动更新 GeoIP
auto-geoip = type=cron,cronexp="0 0 */1 * * *",script-path=https://raw.githubusercontent.com/kongjie0325-art/shadowrocket-anywhere-config/master/scripts/auto-geoip.js
