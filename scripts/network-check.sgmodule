#!name=网络检测脚本
#!desc=自动 IP 检测、DNS 解析测试、节点延迟测试
#!category=网络

[Script]
# 获取出口 IP
ip-check = type=http-request,pattern=^https://api\.ipify\.org,script-path=https://raw.githubusercontent.com/kongjie0325-art/shadowrocket-anywhere-config/master/scripts/ip-check.js

# DNS 解析测试
dns-check = type=http-request,pattern=^https://1\.1\.1\.1/dns-query,script-path=https://raw.githubusercontent.com/kongjie0325-art/shadowrocket-anywhere-config/master/scripts/dns-check.js

# 节点延迟测试
node-latency = type=http-request,pattern=^http://www\.gstatic\.com/generate_204,script-path=https://raw.githubusercontent.com/kongjie0325-art/shadowrocket-anywhere-config/master/scripts/latency-check.js
