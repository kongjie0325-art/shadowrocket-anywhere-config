#!name=App 增强脚本
#!desc=通用 App 增强：UA 伪装、追踪防护、请求优化
#!category=系统

[Script]
# UA 伪装
ua-spoof = type=http-request,pattern=^https?://,script-path=https://raw.githubusercontent.com/kongjie0325-art/shadowrocket-anywhere-config/master/scripts/app-enhance.js

# 追踪参数移除
tracker-strip = type=http-request,pattern=^https?://,script-path=https://raw.githubusercontent.com/kongjie0325-art/shadowrocket-anywhere-config/master/scripts/tracker-strip.js
