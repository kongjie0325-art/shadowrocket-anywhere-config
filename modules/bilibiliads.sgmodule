# Bilibili 去广告规则 - 从 anywhere kokoryh/Sparkle 提取
# 覆盖：开屏/信息流/搜索/直播间/我的页面/追番

[URL Rewrite]
# 开屏广告（直接屏蔽API响应）
^https://[^/]+/x/v2/splash/(?:list|show|event/list2)(?:\?|$) - reject-200

# 顶部活动banner
^https://[^/]+/x/resource/top/activity(?:\?|$) - reject-200
^https://[^/]+/x/resource/patch/tab(?:/v2)?(?:\?|$) - reject-200

# 搜索广场/热词
^https://[^/]+/x/v2/search/square(?:\?|$) - reject-200

# 角标气泡/VIP素材
^https://[^/]+/x/vip/ads/materials(?:\?|$) - reject-200
^https://[^/]+/pgc/activity/deliver/material/receive(?:\?|$) - reject-200
^https://[^/]+/game/live/large_card_material(?:\?|$) - reject-200
^https://[^/]+/xlive/e-commerce-interface/v1/ecommerce-user/get_shopping_info(?:\?|$) - reject-200

[Script]
# B站 Tab 页净化（删除 splash / top_more）
bilibili-tab = type=http-response,pattern=^https://[^/]+/x/resource/show/tab/v2(?:\?|$),script-path=scripts/bilibili-ad.js,requires-body=1,max-size=1048576,timeout=10

# B站 首页信息流净化（删除卡片广告）
bilibili-feed = type=http-response,pattern=^https://[^/]+/x/v2/feed/index(?:/story)?(?:\?|$),script-path=scripts/bilibili-ad.js,requires-body=1,max-size=2097152,timeout=10

# B站 我的页面净化（删除皮肤装扮/装扮中心）
bilibili-mine = type=http-response,pattern=^https://[^/]+/x/v2/account/(?:mine(?:/ipad)?|myinfo)(?:\?|$),script-path=scripts/bilibili-ad.js,requires-body=1,max-size=1048576,timeout=10

# B站 直播间净化
bilibili-live-feed = type=http-response,pattern=^https://[^/]+/xlive/app-interface/v2/index/feed(?:\?|$),script-path=scripts/bilibili-ad.js,requires-body=1,max-size=1048576,timeout=10
bilibili-live-room = type=http-response,pattern=^https://[^/]+/xlive/app-room/v1/index/getInfoBy(?:Room|User)(?:\?|$),script-path=scripts/bilibili-ad.js,requires-body=1,max-size=1048576,timeout=10

# B站 视频详情页广告清除
bilibili-view = type=http-response,pattern=^https://[^/]+/x/v2/view(?:\?|$),script-path=scripts/bilibili-ad.js,requires-body=1,max-size=1048576,timeout=10

# B站 频道页清空（广告推荐卡片）
bilibili-channel = type=http-response,pattern=^https://[^/]+/pgc/page/channel(?:\?|$),script-path=scripts/bilibili-ad.js,requires-body=1,max-size=524288,timeout=10

# B站 皮肤页清理
bilibili-skin = type=http-response,pattern=^https://[^/]+/x/resource/show/skin(?:\?|$),script-path=scripts/bilibili-ad.js,requires-body=1,max-size=131072,timeout=10

# B站 评论区净化
bilibili-comments = type=http-response,pattern=^https://[^/]+/x/v2/reply/main(?:\?|$),script-path=scripts/bilibili-ad.js,requires-body=1,max-size=1048576,timeout=10

# B站 收藏页清理
bilibili-favorite = type=http-response,pattern=^https://[^/]+/x/v2/fav/topic/list(?:\?|$),script-path=scripts/bilibili-ad.js,requires-body=1,max-size=131072,timeout=10
