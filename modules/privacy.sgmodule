#!name=隐私保护
#!desc=阻止追踪器、分析工具、指纹识别、追踪像素
#!category=隐私
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Privacy.png

[Rule]
# 追踪器拦截
DOMAIN-KEYWORD,fingerprint,REJECT
DOMAIN-KEYWORD,tracking,REJECT
DOMAIN-KEYWORD,telemetry,REJECT
DOMAIN-KEYWORD,metrics,REJECT
DOMAIN-KEYWORD,beacon,REJECT

# 常见追踪服务
DOMAIN-SUFFIX,crazyegg.com,REJECT
DOMAIN-SUFFIX,hotjar.com,REJECT
DOMAIN-SUFFIX,bugsnag.com,REJECT
DOMAIN-SUFFIX,sentry.io,REJECT
DOMAIN-SUFFIX,newrelic.com,REJECT
DOMAIN-SUFFIX,omtrdc.net,REJECT
DOMAIN-SUFFIX,optimizely.com,REJECT
DOMAIN-SUFFIX,appboy.com,REJECT
DOMAIN-SUFFIX,branch.io,REJECT
DOMAIN-SUFFIX,adjust.com,REJECT
DOMAIN-SUFFIX,appsflyer.com,REJECT

# Facebook 追踪
DOMAIN-SUFFIX,fbsbx.com,REJECT
DOMAIN-SUFFIX,atdmt.com,REJECT
DOMAIN-SUFFIX,facebook-web-clients.appspot.com,REJECT
