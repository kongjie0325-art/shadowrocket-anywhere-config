#!url=https://raw.githubusercontent.com/kongjie0325-art/shadowrocket-anywhere-config/master/modules/youtubeads.sgmodule
#!name=YouTube 去广告
#!desc=YouTube 全平台广告拦截：网页重写 + iOS App 端 Protobuf 视频贴片广告过滤（完全独立运行）
#!category=广告拦截
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/YouTube.png

[URL Rewrite]
# Web/API 统计与页面广告请求拦截（使用 200 模拟空回应，防止视频加载转圈）
^https?://(www|s)\.youtube\.com/api/stats/ads - reject-200
^https?://(www|s)\.youtube\.com/(pagead|ptracking) - reject-200
^https?://s\.youtube\.com/api/stats/qoe\?adcontext - reject-200

[Script]
# App 视频流 Protobuf 广告信息剔除脚本
youtube-ad = type=http-response,engine=jsc,script-path=https://raw.githubusercontent.com/kongjie0325-art/shadowrocket-anywhere-config/master/scripts/youtube-ads.js,pattern=^https?://youtubei\.googleapis\.com,max-size=524288,requires-body=true,timeout=10,script-update-interval=0

[MITM]
hostname = %APPEND% youtubei.googleapis.com, *.youtube.com, s.youtube.com
