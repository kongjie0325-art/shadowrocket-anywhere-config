#!name=YouTube 去广告
#!desc=YouTube 广告拦截：开屏、信息流、暂停、贴片广告
#!category=广告拦截
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/YouTube.png

[URL Rewrite]
^https?://(www|s)\.youtube\.com/api/stats/ads - reject-200
^https?://(www|s)\.youtube\.com/(pagead|ptracking) - reject-200
^https?://s\.youtube\.com/api/stats/qoe\?adcontext - reject-200

[Script]
# YouTube 广告脚本 - 清理播放器响应中的广告字段
youtube-ads = type=http-response,pattern=^https?://youtubei\.googleapis\.com/,script-path=https://raw.githubusercontent.com/kongjie0325-art/shadowrocket-anywhere-config/master/scripts/youtube-ads.js,requires-body=1,max-size=524288,timeout=10

[MITM]
enable = true
hostname = %APPEND% youtubei.googleapis.com
