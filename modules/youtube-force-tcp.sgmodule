#!url=https://raw.githubusercontent.com/kongjie0325-art/shadowrocket-anywhere-config/master/modules/youtube-force-tcp.sgmodule
#!name=YouTube Force TCP
#!desc=将 YouTube/googlevideo 的 QUIC(443/UDP) 回退为 TCP，解决部分播放器卡顿/广告问题
#!category=功能模块
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/YouTube.png

[Rule]
AND,((DOMAIN-SUFFIX,googlevideo.com),(PROTOCOL,UDP),(DEST-PORT,443)),REJECT
AND,((DOMAIN,youtubei.googleapis.com),(PROTOCOL,UDP),(DEST-PORT,443)),REJECT
