#!name=通用广告拦截
#!desc=基于域名/IP/URL-REJECT的综合广告过滤模块
#!category=广告拦截
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/AdBlack.png

[Rule]
# 广告关键词拦截
DOMAIN-KEYWORD,ads,REJECT
DOMAIN-KEYWORD,adsense,REJECT
DOMAIN-KEYWORD,adserver,REJECT
DOMAIN-KEYWORD,doubleclick,REJECT
DOMAIN-KEYWORD,analytics,REJECT
DOMAIN-KEYWORD,tracker,REJECT
DOMAIN-KEYWORD,telemetry,REJECT
DOMAIN-KEYWORD,adnxs,REJECT
DOMAIN-KEYWORD,adtech,REJECT
DOMAIN-KEYWORD,adclick,REJECT
DOMAIN-KEYWORD,admob,REJECT
DOMAIN-KEYWORD,mopub,REJECT
DOMAIN-KEYWORD,unityads,REJECT
DOMAIN-KEYWORD,ironsrc,REJECT
DOMAIN-KEYWORD,vungle,REJECT
DOMAIN-KEYWORD,applovin,REJECT
DOMAIN-KEYWORD,chartboost,REJECT

# 广告域名拦截
DOMAIN-SUFFIX,admob.com,REJECT
DOMAIN-SUFFIX,googlesyndication.com,REJECT
DOMAIN-SUFFIX,googleadservices.com,REJECT
DOMAIN-SUFFIX,google-analytics.com,REJECT
DOMAIN-SUFFIX,doubleclick.net,REJECT
DOMAIN-SUFFIX,googletagmanager.com,REJECT
DOMAIN-SUFFIX,googletagservices.com,REJECT
DOMAIN-SUFFIX,amazon-adsystem.com,REJECT
DOMAIN-SUFFIX,ads-twitter.com,REJECT
DOMAIN-SUFFIX,t.co,REJECT

# 远程广告规则集
RULE-SET,https://raw.githubusercontent.com/fengzhiguyin/adblock-scripts/main/rules/ads_merged.txt,REJECT
RULE-SET,https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Shadowrocket/Advertising/Advertising.list,REJECT

[URL Rewrite]
# 开屏广告
^https?://(.*\.)?api\.m\.mi\.com/v\d/app/start - reject
^https?://(.*\.)?api\.vuevideo\.net/api/v\d/ad/ - reject
^https?://(.*\.)?api\.gaoqingdianshi\.com/api/v\d/ad/ - reject
^https?://(.*\.)?api\.bjxkhc\.com/index\.php/app/ios/ad/ - reject

[MITM]
enable = true
hostname = %APPEND% *.google-analytics.com, *.googlesyndication.com, *.doubleclick.net
