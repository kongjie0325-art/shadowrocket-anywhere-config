#!url=https://raw.githubusercontent.com/kongjie0325-art/shadowrocket-anywhere-config/master/modules/tiktok-unlock.sgmodule
#!name=TikTok 解锁
#!desc=TikTok 区域解锁 + 广告/直播屏蔽（完全独立运行）
#!category=功能模块
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/TikTok.png

[URL Rewrite]
# SIM 卡代码与系统区域强制篡改为美区 (US)
(?<=_region=)CN(?=&) US 307
(?<=&mcc_mnc=)460[0-9]{2}(?=&) 310410 307
(?<=&sys_region=)CN(?=&) US 307
(?<=&carrier_region=)CN(?=&) US 307

# TikTok 广告/统计/直播屏蔽（200 防止转圈）
^https?://(.+\.)?tiktok\.com/api/stats/ads - reject-200
^https?://(.+\.)?tiktok\.com/pagead - reject-200
^https?://(.+\.)?tiktok\.com/ptracking - reject-200
^https?://(.+\.)?byteoversea\.com/api/stats/ads - reject-200
^https?://(.+\.)?byteoversea\.com/pagead - reject-200

[Script]
# TikTok 广告脚本
tiktok-ad = type=http-response,pattern=^https?://(.+\.)?(tiktokv|byteoversea|tiktok)\.com/,script-path=https://raw.githubusercontent.com/kongjie0325-art/shadowrocket-anywhere-config/master/scripts/tiktok-ad.js,requires-body=1,max-size=1048576,timeout=10

[MITM]
hostname = %APPEND% *.tiktokv.com, *.byteoversea.com, *.tik-tokapi.com, *.tiktok.com, *.bytednsdoc.com, *.bytemastatic.com, *.byteintl.com, *.byteintl.net, *.isnssdk.com, *.sgpstatp.com, *.ttwstatic.com
