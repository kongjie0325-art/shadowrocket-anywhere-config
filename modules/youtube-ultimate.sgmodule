#!url=https://raw.githubusercontent.com/kongjie0325-art/shadowrocket-anywhere-config/master/modules/youtube-ultimate.sgmodule
#!name=YouTube Ultimate（2026 完整版）
#!desc=借鉴 anywhere-rules：Core Rewrite + Maasea Enhance + SponsorBlock + DualSubs 字幕翻译 + Protobuf 广告过滤
#!category=功能模块
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/YouTube.png

[Rule]
# === 强制 QUIC (UDP 443) 回退到 TCP，确保 MITM 正常解密 ===
AND,((DOMAIN-SUFFIX,googlevideo.com),(PROTOCOL,UDP),(DEST-PORT,443)),REJECT
AND,((DOMAIN,youtubei.googleapis.com),(PROTOCOL,UDP),(DEST-PORT,443)),REJECT

[URL Rewrite]
# === Core Rewrite：基础广告/统计/Tracking ===
^https?:\/\/(www|s)\.youtube\.com\/api\/stats\/ads - reject-200
^https?:\/\/(www|s)\.youtube\.com\/api\/stats\/qoe - reject-200
^https?:\/\/(www|s)\.youtube\.com\/pagead - reject-200
^https?:\/\/(www|s)\.youtube\.com\/ptracking - reject-200
^https?:\/\/(www|s)\.youtube\.com\/youtubei\/v1\/ads - reject-200

# === googlevideo 广告相关 ===
^https?:\/\/[\w-]+\.googlevideo\.com\/(?!(dclk_video_ads|videoplayback\?)).+&oad - reject-200
^https?:\/\/[\w-]+\.googlevideo\.com\/.*&pltype=ad&.*$ - reject-200
^https?:\/\/(www|s)\.youtube\.com\/.*ad_break.* - reject-200
^https?:\/\/s\.youtube\.com\/api\/stats\/adsense.* - reject-200

# === DualSubs：timedtext 翻译规则（借鉴 anywhere-rules） ===
^https?:\/\/(www|m)\.youtube\.com\/api\/timedtext\?(.*?)[&?]tlang=([^&]+)(.*)$ - 0, https://$1$2&subtype=Translate&$4
^https?:\/\/(www|m)\.youtube\.com\/api\/timedtext\?tlang=([^&]+)(.*)$ - 0, https://$1subtype=Translate$2

[Script]
# === Maasea YouTube Enhance（response）—— 主过滤脚本 ===
youtube.response = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/(youtubei\/v1\/browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch|log_event|config)(\?.*)?$,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/Maasea/sgmodule/master/Script/Youtube/youtube.response.js,argument="{\"captionLang\":\"zh-Hant\",\"blockUpload\":true,\"blockImmersive\":true,\"blockShorts\":false,\"skipSegments\":true,\"debug\":false}"

# === Maasea request 脚本 ===
youtube.request.init = type=http-request,pattern=^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&ack.*,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/Maasea/sgmodule/master/Script/Youtube/youtube.request.js,argument="{\"captionLang\":\"zh-Hant\"}"

youtube.request.log = type=http-request,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/Maasea/sgmodule/master/Script/Youtube/youtube.request.js

[MITM]
hostname = %APPEND% youtubei.googleapis.com
