# 高德地图去广告增强版 - 从 anywhere RuCu6/kelv1n1n 提取
# 覆盖：开屏/主页/搜索/导航/打车/公交

[URL Rewrite]
# 开屏广告
^https://[^/]+/ws/valueadded/alimama/splash_screen(?:\?|$) - reject-200

# 广告域名
^http://amdc\.m\.taobao\.com/amdc/mobileDispatch(?:/?|\?|$) - reject-200

# 打车相关广告
^https://m5-zb\.amap\.com/ws/boss/(?:order/car/(?:feedback/get_card_questions|feedback/viptips|king_toolbox_car_bubble|remark/satisfactionConf|rights_information)|tips/onscene_visual_optimization)(?:/?|\?|$) - reject-200
^https://m5-zb\.amap\.com/ws/boss/(?:pay/web/paySuccess/info/request|transportation/diversion/resource/driving)(?:/?|\?|$) - reject-200

# 主页广告
^https://m5\.amap\.com/ws/aos/main/page/product/list(?:\?|$) - reject-200
^https://m5\.amap\.com/ws/faas/amap-navigation/(?:main-page-assets|main-page-location|ridewalk-end-fc|usr-profile-fc/homeV2)(?:/?|\?|$) - reject-200

# 搜索广告
^https://m5\.amap\.com/ws/shield/search_business/process/orderList(?:\?|$) - reject-200
^https://m5\.amap\.com/ws/shield/search/new_hotword(?:\?|$) - reject-200
^https://m5\.amap\.com/ws/faas/amap-navigation/card-service-(?:car-end|route-plan)(?:/?|\?|$) - reject-200
^https://m5\.amap\.com/ws/shield/search_poi/tips_adv(?:\?|$) - reject-200
^https://m5\.amap\.com/ws/shield/search/common/coupon/info(?:\?|$) - reject-200

# 其他广告
^https://oss\.amap\.com/ws/banner/lists/(?:\?|$) - reject-200
^https://ai\.amap\.com/v1/ai_rec/ - reject-200
^https://m5\.amap\.com/ws/mapapi/hint_text/offline_data(?:\?|$) - reject-200
^https://m5\.amap\.com/ws/message/notice/list(?:\?|$) - reject-200
^https://m5\.amap\.com/ws/shield/search/new_hotword(?:\?|$) - reject-200
^https://m5\.amap\.com/ws/shield/scene/recommend(?:\?|$) - reject-200
^https://m5\.amap\.com/ws/valueadded/weather/v2(?:\?|$) - reject-200
^https://sns\.amap\.com/ws/msgbox/pull_mp(?:\?|$) - reject-200
^https://m5-zb\.amap\.com/ws/ride/home/page/get_commuting_card(?:\?|$) - reject-200

[Script]
# 高德导航主页广告清理
amap-navigation = type=http-response,pattern=^https://m5\.amap\.com/ws/faas/amap-navigation/(?:card-service-plan-home|main-page)(?:/?|\?|$),script-path=https://raw.githubusercontent.com/kongjie0325-art/shadowrocket-anywhere-config/master/scripts/amap-ad.js,requires-body=1,max-size=524288,timeout=10

# 高德打车订单广告清理
amap-car = type=http-response,pattern=^https://m5-zb\.amap\.com/ws/boss/car/order/content_info(?:\?|$),script-path=https://raw.githubusercontent.com/kongjie0325-art/shadowrocket-anywhere-config/master/scripts/amap-ad.js,requires-body=1,max-size=131072,timeout=10

# 高德搜索页广告清理
amap-search = type=http-response,pattern=^https://m5\.amap\.com/ws/shield/search_bff/hotword(?:\?|$),script-path=https://raw.githubusercontent.com/kongjie0325-art/shadowrocket-anywhere-config/master/scripts/amap-ad.js,requires-body=1,max-size=131072,timeout=10

# 高德POI详情广告清理
amap-poi = type=http-response,pattern=^https://m5\.amap\.com/ws/shield/search_poi/detail(?:\?|$),script-path=https://raw.githubusercontent.com/kongjie0325-art/shadowrocket-anywhere-config/master/scripts/amap-ad.js,requires-body=1,max-size=524288,timeout=10

# 高德搜索建议广告清理
amap-sug = type=http-response,pattern=^https://m5\.amap\.com/ws/shield/search_poi/sug(?:\?|$),script-path=https://raw.githubusercontent.com/kongjie0325-art/shadowrocket-anywhere-config/master/scripts/amap-ad.js,requires-body=1,max-size=131072,timeout=10

# 高德搜索附近广告清理
amap-nearby = type=http-response,pattern=^https://m5\.amap\.com/ws/shield/search/nearbyrec_smart(?:\?|$),script-path=https://raw.githubusercontent.com/kongjie0325-art/shadowrocket-anywhere-config/master/scripts/amap-ad.js,requires-body=1,max-size=131072,timeout=10

# 高德导航路线广告清理
amap-route = type=http-response,pattern=^https://m5\.amap\.com/ws/perception/drive/(?:routeInfo|routePlan)(?:/?|\?|$),script-path=https://raw.githubusercontent.com/kongjie0325-art/shadowrocket-anywhere-config/master/scripts/amap-ad.js,requires-body=1,max-size=131072,timeout=10

# 高德公交规划广告清理
amap-bus = type=http-response,pattern=^https://m5\.amap\.com/ws/bus/plan/integrate(?:\?|$),script-path=https://raw.githubusercontent.com/kongjie0325-art/shadowrocket-anywhere-config/master/scripts/amap-ad.js,requires-body=1,max-size=131072,timeout=10

# 高德酒店搜索广告清理
amap-hotel = type=http-response,pattern=^https://m5\.amap\.com/ws/c3frontend/af-hotel/page/main(?:\?|$),script-path=https://raw.githubusercontent.com/kongjie0325-art/shadowrocket-anywhere-config/master/scripts/amap-ad.js,requires-body=1,max-size=524288,timeout=10

# 高德附近推荐广告清理
amap-nearbyrec = type=http-response,pattern=^https://m5\.amap\.com/ws/c3frontend/af-nearby/nearby(?:\?|$),script-path=https://raw.githubusercontent.com/kongjie0325-art/shadowrocket-anywhere-config/master/scripts/amap-ad.js,requires-body=1,max-size=131072,timeout=10

# 高德首页运营广告清理
amap-home = type=http-response,pattern=^https://m5\.amap\.com/ws/c3frontend/af-launch/page/main(?:\?|$),script-path=https://raw.githubusercontent.com/kongjie0325-art/shadowrocket-anywhere-config/master/scripts/amap-ad.js,requires-body=1,max-size=131072,timeout=10

# 高德运营活动广告清理
amap-promo = type=http-response,pattern=^https://m5\.amap\.com/ws/promotion-web/resource(?:/home)?(?:\?|$),script-path=https://raw.githubusercontent.com/kongjie0325-art/shadowrocket-anywhere-config/master/scripts/amap-ad.js,requires-body=1,max-size=131072,timeout=10

# 高德DSP广告清理
amap-dsp = type=http-response,pattern=^https://m5\.amap\.com/ws/shield/dsp/profile/index/nodefaasv3(?:\?|$),script-path=https://raw.githubusercontent.com/kongjie0325-art/shadowrocket-anywhere-config/master/scripts/amap-ad.js,requires-body=1,max-size=131072,timeout=10

# 高德FrogServer广告清理
amap-frog = type=http-response,pattern=^https://m5\.amap\.com/ws/shield/frogserver/aocs/updatable/1(?:\?|$),script-path=https://raw.githubusercontent.com/kongjie0325-art/shadowrocket-anywhere-config/master/scripts/amap-ad.js,requires-body=1,max-size=524288,timeout=10
